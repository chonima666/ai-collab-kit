#!/usr/bin/env bash
# Test double for curl: answers GitHub, OpenAI and Discord requests from files in $FAKE_DIR and
# logs one line per request to $FAKE_DIR/calls. Only the options the kit's scripts use are known.
out="" fmt="" url="" data="" method=GET fail=no
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) fmt="$2"; shift 2 ;;
    -K) url="$(sed -n 's/^url = "\(.*\)"$/\1/p' "$2")"; shift 2 ;;
    -H|--connect-timeout|--max-time) shift 2 ;;
    --data-binary)
      method=POST
      if [ "$2" = @- ]; then data="$(cat)"; else data="$(cat "${2#@}")"; fi
      shift 2 ;;
    http*) url="$1"; shift ;;
    --*) shift ;;
    -*) case "$1" in *f*) fail=yes ;; esac; shift ;;
    *) shift ;;
  esac
done
F="$FAKE_DIR" status=200 body=""
page="${url##*page=}"
case "$method $url" in
  "GET "*/pulls/*/reviews*) kind=get_reviews; if [ "$page" = 1 ]; then body="$(cat "$F/reviews.json")"; else body='[]'; fi ;;
  "GET "*/issues/*/comments*) kind=get_comments; if [ "$page" = 1 ]; then body="$(cat "$F/comments.json")"; else body='[]'; fi ;;
  "GET "*/pulls/*) kind=get_pr; body="$(cat "$F/pr.json")" ;;
  "POST "*/pulls/*/reviews)
    kind=post_review
    status="$(cat "$F/post_status" 2>/dev/null || echo 200)"
    body="$(cat "$F/post_response" 2>/dev/null || echo '{"user":{"login":"rev-app[bot]"}}')"
    printf '%s' "$data" > "$F/posted.json" ;;
  "POST "*/chat/completions)
    kind=model
    printf '%s' "$data" > "$F/model_request.json"
    if [ -f "$F/model_timeout" ]; then echo model >> "$F/calls"; echo "curl: (28) Operation timed out" >&2; exit 28; fi
    status="$(cat "$F/model_status" 2>/dev/null || echo 200)"
    body="$(jq -n --rawfile c "$F/model_output.txt" '{choices: [{message: {content: $c}}]}')" ;;
  "POST "*discord*) kind=discord; printf '%s\n' "$data" >> "$F/discord.log"; status=204 ;;
  *) kind="unknown $method $url" ;;
esac
echo "$kind" >> "$F/calls"
if [ -n "$out" ]; then printf '%s' "$body" > "$out"; else printf '%s' "$body"; fi
case "$fmt" in *http_code*) printf '%s' "$status" ;; esac
if [ "$fail" = yes ] && [ "$status" -ge 400 ]; then exit 22; fi
exit 0
